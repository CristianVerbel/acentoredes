# =============================================================================
# Backend del Monitor Electoral - variables de entorno
# Copia a backend/.env y ajusta lo que necesites. Todo es opcional para la demo.
# =============================================================================

# --- Base de datos (por defecto SQLite local) ---
# DATABASE_URL=sqlite:///./monitor.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/monitor

# --- Ruta del archivo de contexto electoral ---
# ELECTION_CONFIG_PATH=../config/election.yaml

# --- CORS (origen del frontend Next.js) ---
CORS_ORIGINS=http://localhost:3000

# --- Analisis con LLM (opcional). Sin esto se usa el analizador por reglas. ---
USE_LLM_ANALYSIS=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# --- Credenciales de fuentes reales (opcionales) ---
# X / Twitter API v2
TWITTER_BEARER_TOKEN=
# YouTube Data API v3
YOUTUBE_API_KEY=
# Reddit (OAuth opcional; el conector usa endpoints publicos por defecto)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

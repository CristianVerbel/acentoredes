# =============================================================================
# Variables de Entorno - Acento Redes / OpenClaw + WhatsApp
# =============================================================================
# Copia este archivo a .env y configura tus valores:
#   cp .env.example .env
# =============================================================================

# --- Proveedor de IA ---
# Opciones: anthropic, openai, deepseek
OPENCLAW_MODEL_PROVIDER=anthropic

# --- API Keys (configura al menos una segun el proveedor) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# --- Gateway ---
GATEWAY_PORT=18789

# --- Proxy (opcional, si estas detras de un firewall corporativo) ---
HTTPS_PROXY=
HTTP_PROXY=
